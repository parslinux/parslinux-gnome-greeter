<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.parslinux.parslinux-gnome-greeter</id>
  
  <name>ParsLinux GNOME Greeter</name>
  <_comment>Configure your new ParsLinux GNOME desktop</_comment>
  
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <developer_name>ParsLinux</developer_name>
  
  <description>
    <p>
      ParsLinux Greeter is a welcome application designed for the ParsLinux GNOME desktop. It helps users with initial setup and configuration of their new system.
    </p>
  </description>
  
  <launchable type="desktop-id">org.parslinux.parslinux-gnome-greeter.desktop</launchable>
  
  <provides>
    <binary>parslinux-gnome-greeter</binary>
  </provides>
</component> 